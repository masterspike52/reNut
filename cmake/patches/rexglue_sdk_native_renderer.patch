+std::mutex& DebugLabelMutex() {
+  static std::mutex m;
+  return m;
+}
+
+std::unordered_map<uint64_t, DebugLabelEntry>& DebugLabelPositions() {
+  static std::unordered_map<uint64_t, DebugLabelEntry> positions;
+  return positions;
+}
