# Codegen template composition.
#
# Codegen reads a single template_dir, and each file there replaces a stock template whole. So modules don't
# ship templates; they add fragments at anchor lines in the stock ones, and RexFabric writes the result to the
# project's template_dir once every module has added its own.
#
#   rexfabric_template_fragment(codegen/pch_h BEFORE "#ifndef DECLARE_REX_FUNC" FILE fragment.inja)
#   rexfabric_template_fragment(codegen/pch_h AFTER "<anchor>" FILE fragment.inja)
#   rexfabric_template_fragment(codegen/init_cpp APPEND FILE fragment.inja)
#
# An anchor must appear exactly once in the stock template. When an SDK update moves or drops one, configuring
# fails and names the fragment, instead of codegen silently losing it.

function(rexfabric_template_fragment template)
  cmake_parse_arguments(ARG "APPEND" "BEFORE;AFTER;FILE" "" ${ARGN})
  if(NOT ARG_FILE)
    message(FATAL_ERROR "rexfabric_template_fragment(${template}): FILE is required")
  endif()
  # Stored lowercase: an uppercase APPEND would read as set_property's own keyword.
  if(ARG_APPEND)
    set(mode append)
  elseif(DEFINED ARG_BEFORE)
    set(mode before)
    set(anchor "${ARG_BEFORE}")
  elseif(DEFINED ARG_AFTER)
    set(mode after)
    set(anchor "${ARG_AFTER}")
  else()
    message(FATAL_ERROR "rexfabric_template_fragment(${template}): give BEFORE, AFTER or APPEND")
  endif()
  get_property(count GLOBAL PROPERTY REXFABRIC_FRAGMENT_COUNT)
  if(NOT count)
    set(count 0)
  endif()
  set_property(GLOBAL PROPERTY REXFABRIC_FRAGMENT_${count}_TEMPLATE "${template}")
  set_property(GLOBAL PROPERTY REXFABRIC_FRAGMENT_${count}_MODE "${mode}")
  set_property(GLOBAL PROPERTY REXFABRIC_FRAGMENT_${count}_ANCHOR "${anchor}")
  set_property(GLOBAL PROPERTY REXFABRIC_FRAGMENT_${count}_FILE "${ARG_FILE}")
  math(EXPR count "${count} + 1")
  set_property(GLOBAL PROPERTY REXFABRIC_FRAGMENT_COUNT ${count})
endfunction()

# Inserts one fragment into `text_var`.
function(_rexfabric_apply_fragment text_var template mode anchor file)
  file(READ "${file}" fragment)
  set(text "${${text_var}}")
  if(mode STREQUAL "append")
    string(APPEND text "${fragment}")
  else()
    string(FIND "${text}" "${anchor}" first)
    string(FIND "${text}" "${anchor}" last REVERSE)
    if(first EQUAL -1)
      message(FATAL_ERROR "RexFabric: anchor \"${anchor}\" is gone from the SDK's ${template} template, so ${file} has nowhere to go. Update the fragment for this SDK version.")
    elseif(NOT first EQUAL last)
      message(FATAL_ERROR "RexFabric: anchor \"${anchor}\" appears more than once in the SDK's ${template} template (${file}). Use a longer anchor.")
    endif()
    set(at ${first})
    if(mode STREQUAL "after")
      string(LENGTH "${anchor}" anchor_length)
      math(EXPR at "${at} + ${anchor_length}")
    endif()
    string(SUBSTRING "${text}" 0 ${at} head)
    string(SUBSTRING "${text}" ${at} -1 tail)
    set(text "${head}${fragment}${tail}")
  endif()
  set(${text_var} "${text}" PARENT_SCOPE)
endfunction()

# Writes every composed template into `out_dir`, rewriting a file only when its text changed so codegen doesn't
# rerun for nothing, and removes templates no fragment asks for any more.
function(rexfabric_write_templates sdk_dir out_dir)
  get_property(count GLOBAL PROPERTY REXFABRIC_FRAGMENT_COUNT)
  if(NOT count)
    return()
  endif()
  math(EXPR last "${count} - 1")
  set(templates "")
  foreach(i RANGE ${last})
    get_property(template GLOBAL PROPERTY REXFABRIC_FRAGMENT_${i}_TEMPLATE)
    list(APPEND templates "${template}")
  endforeach()
  list(REMOVE_DUPLICATES templates)

  set(written "")
  foreach(template IN LISTS templates)
    set(stock "${sdk_dir}/${template}.inja")
    if(NOT EXISTS "${stock}")
      message(FATAL_ERROR "RexFabric: the SDK has no ${template} template (looked for ${stock})")
    endif()
    file(READ "${stock}" text)
    set_property(DIRECTORY "${CMAKE_SOURCE_DIR}" APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${stock}")
    foreach(i RANGE ${last})
      get_property(fragment_template GLOBAL PROPERTY REXFABRIC_FRAGMENT_${i}_TEMPLATE)
      if(fragment_template STREQUAL template)
        get_property(mode GLOBAL PROPERTY REXFABRIC_FRAGMENT_${i}_MODE)
        get_property(anchor GLOBAL PROPERTY REXFABRIC_FRAGMENT_${i}_ANCHOR)
        get_property(file GLOBAL PROPERTY REXFABRIC_FRAGMENT_${i}_FILE)
        _rexfabric_apply_fragment(text "${template}" "${mode}" "${anchor}" "${file}")
        set_property(DIRECTORY "${CMAKE_SOURCE_DIR}" APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${file}")
      endif()
    endforeach()
    set(out "${out_dir}/${template}.inja")
    set(current "")
    if(EXISTS "${out}")
      file(READ "${out}" current)
    endif()
    if(NOT current STREQUAL text)
      file(WRITE "${out}" "${text}")
    endif()
    list(APPEND written "${out}")
  endforeach()

  file(GLOB_RECURSE existing "${out_dir}/*.inja")
  foreach(file IN LISTS existing)
    if(NOT file IN_LIST written)
      file(REMOVE "${file}")
    endif()
  endforeach()
endfunction()
